<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_dialog_set_appearance_options"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/textview_set_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/colorPromptText"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SeekBar
            android:id="@+id/seekbar_set_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:progressDrawable="@drawable/seekbar_dialog_progress"
            android:splitTrack="false"
            android:thumb="@drawable/seekbar_dialog_thumb" />

        <EditText
            android:id="@+id/edittext_set_size"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:ems="4"
            android:gravity="center"
            android:inputType="number"
            android:labelFor="@+id/edittext_set_size"
            android:minHeight="52dp"
            android:singleLine="true"
            android:textColor="@color/colorPromptText"
            android:textColorHint="@color/colorPromptText" />

    </LinearLayout>

    <TextView
        android:id="@+id/textview_set_positions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:textColor="@color/colorPromptText"
        android:textSize="15sp" />

    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"
        app:singleLine="false"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/checkbox_option_1"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="92dp"
            android:textAlignment="center"
            android:textColor="@color/chip_choice_text"
            app:checkedIconVisible="true"
            app:chipBackgroundColor="@color/chip_choice_background"
            app:chipCornerRadius="18dp"
            app:chipStrokeColor="@color/chip_choice_stroke"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/colorPrimaryContainer" />

        <com.google.android.material.chip.Chip
            android:id="@+id/checkbox_option_2"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="92dp"
            android:textAlignment="center"
            android:textColor="@color/chip_choice_text"
            app:checkedIconVisible="true"
            app:chipBackgroundColor="@color/chip_choice_background"
            app:chipCornerRadius="18dp"
            app:chipStrokeColor="@color/chip_choice_stroke"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/colorPrimaryContainer" />

        <com.google.android.material.chip.Chip
            android:id="@+id/checkbox_option_3"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="92dp"
            android:textAlignment="center"
            android:textColor="@color/chip_choice_text"
            app:checkedIconVisible="true"
            app:chipBackgroundColor="@color/chip_choice_background"
            app:chipCornerRadius="18dp"
            app:chipStrokeColor="@color/chip_choice_stroke"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/colorPrimaryContainer" />

        <com.google.android.material.chip.Chip
            android:id="@+id/checkbox_option_4"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="92dp"
            android:textAlignment="center"
            android:textColor="@color/chip_choice_text"
            app:checkedIconVisible="true"
            app:chipBackgroundColor="@color/chip_choice_background"
            app:chipCornerRadius="18dp"
            app:chipStrokeColor="@color/chip_choice_stroke"
            app:chipStrokeWidth="1dp"
            app:rippleColor="@color/colorPrimaryContainer" />

    </com.google.android.material.chip.ChipGroup>

</LinearLayout>
