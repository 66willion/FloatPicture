<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".Activities.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <tool.xfy9326.floatpicture.View.AdvancedRecyclerView
                android:id="@+id/main_list_manage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="72dp"
                android:paddingBottom="184dp"
                android:scrollbars="none"
                app:layoutManager="LinearLayoutManager" />

            <include
                android:id="@+id/layout_widget_empty_view"
                layout="@layout/widget_list_empty" />

            <tool.xfy9326.floatpicture.View.RecyclerFastScrollerView
                android:id="@+id/main_fast_scroller"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_fast_scroller_panel"
                android:elevation="18dp"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="8dp"
                android:translationZ="18dp" />

        </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/main_button_drawer_container"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_floating_blur_circle"
        android:clipToOutline="true"
        android:elevation="18dp"
        android:translationZ="18dp">

        <View
            android:id="@+id/main_button_drawer_blur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_floating_blur_circle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/main_button_drawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/open"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="27dp"
            app:icon="@drawable/ic_menu"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/colorPromptText"
            app:strokeColor="@color/colorPromptText"
            app:strokeWidth="1dp" />

    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/main_layout_actions"
        android:layout_width="144dp"
        android:layout_height="144dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="18dp"
        android:elevation="18dp"
        android:translationZ="18dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="22dp"
        app:cardElevation="10dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:strokeWidth="0dp">

        <View
            android:id="@+id/main_layout_actions_blur"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_home_action_blur_surface" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_home_action_double_stroke_outline"
            android:columnCount="2"
            android:padding="12dp"
            android:rowCount="2">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/main_button_add"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:clickable="true"
                android:contentDescription="@string/main_add_overlay"
                android:focusable="true"
                app:backgroundTint="@color/colorFloatingActionButtonBackGround"
                app:elevation="4dp"
                app:fabCustomSize="52dp"
                app:maxImageSize="24dp"
                app:pressedTranslationZ="8dp"
                app:srcCompat="@drawable/ic_add" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/main_button_trusted_overlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:contentDescription="@string/main_trusted_overlay_off"
                app:backgroundTint="@color/colorTrustedOverlayOff"
                app:elevation="4dp"
                app:fabCustomSize="52dp"
                app:maxImageSize="24dp"
                app:pressedTranslationZ="8dp"
                app:srcCompat="@drawable/ic_invisible"
                app:tint="@color/white" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/main_button_pure_overlay"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:contentDescription="@string/main_pure_overlay_off"
                android:focusable="true"
                app:backgroundTint="@color/colorPureOverlayOff"
                app:elevation="4dp"
                app:fabCustomSize="52dp"
                app:maxImageSize="24dp"
                app:pressedTranslationZ="8dp"
                app:srcCompat="@drawable/ic_pure_overlay"
                app:tint="@color/white" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/main_button_random_window"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_margin="4dp"
                android:contentDescription="@string/main_random_window"
                app:backgroundTint="@color/colorRandomAction"
                app:elevation="4dp"
                app:fabCustomSize="52dp"
                app:maxImageSize="24dp"
                app:pressedTranslationZ="8dp"
                app:srcCompat="@drawable/ic_random_window"
                app:tint="@color/white" />

        </GridLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
